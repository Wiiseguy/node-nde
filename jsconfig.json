{
    "compilerOptions": {
        "checkJs": true,
        "target": "ESNext",
        "allowUnusedLabels": false,
        "allowUnreachableCode": false,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "allowJs": true,
        "noImplicitAny": false,
        "strictNullChecks": true
    },
    "exclude": [
        "coverage"
    ]
}